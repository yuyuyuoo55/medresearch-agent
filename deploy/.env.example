# deploy/.env.example
# 用法：复制为 deploy/.env（只在服务器上创建，不提交、不进镜像）
#   cp deploy/.env.example deploy/.env   # 然后填入真实密钥
# 注意：所有值都是占位符，不要提交真实密钥

# ---------- 对外端口 ----------
# web 服务映射到宿主机的端口（默认 80）
WEB_PORT=80

# ---------- MySQL root（仅初始化容器用，不要给应用用） ----------
MYSQL_ROOT_PASSWORD=改成一段强密码
MYSQL_DATABASE=deepsearch_db

# ---------- 应用连接 MySQL ----------
# 用 compose 的 mysql profile 时：容器内通过服务名 mysql 互访，端口 3306
# 连接外部已有 MySQL 时：改成宿主机地址和端口（Windows 上用 host.docker.internal）
MYSQL_HOST=mysql
MYSQL_PORT=3306
# 必须是只读账号，不要用 root（本项目实际账号名：deepsearch_reader）
MYSQL_USER=deepsearch_reader
MYSQL_PASSWORD=改成只读账号密码
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ---------- 大模型 ----------
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# ---------- Tavily 联网搜索 ----------
TAVILY_API_KEY=你的_TAVILY_API_KEY

# ---------- RAGFlow 内部知识库 ----------
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key
